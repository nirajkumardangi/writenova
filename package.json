{
  "name": "writenova",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --workspace @writenova/client",
    "dev:server": "npm run dev --workspace @writenova/server",
    "build": "npm run build --workspace @writenova/client",
    "lint": "npm run lint --workspace @writenova/client",
    "start:client": "npm run start --workspace @writenova/client",
    "start:server": "npm run start --workspace @writenova/server"
  }
}
